+            const uint64_t line = (uint32_t)c->reserve_addr & ~127u;
+            if (first <= line && line <= last) c->reserve_addr = PPU_RESV_INVALID;
+        }
+    }
+    for (uint64_t line = first; line <= last; line += 128) spu_coh_notify_write((uint32_t)line);
+    spu_lockline_unlock();
+    for (unsigned i = PPU_RESV_LOCKS; i-- > 0;) if (shards[i]) resv_unlock(g_resv_locks + i);
