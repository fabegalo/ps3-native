+extern "C" guest_shared_id guest_shared_create(uint64_t size) {
+    if (!valid_range(0, size)) return 0;
+    auto backing = std::make_shared<Backing>(); backing->size = size;
+#ifdef _WIN32
+    backing->handle = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        DWORD(size >> 32), DWORD(size), nullptr);
+    if (!backing->handle) return 0;
+#else
+    char path[] = "/tmp/ps3recomp-shared-XXXXXX";
+    backing->handle = mkstemp(path);
