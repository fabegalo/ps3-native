+    if (!placeholder(p, address, size)) return 0;
+#ifdef _WIN32
+    if (!alloc2()(nullptr, p.base + address, SIZE_T(size), MEM_RESERVE | MEM_COMMIT | MEM_REPLACE_PLACEHOLDER,
