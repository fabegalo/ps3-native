+extern "C" int guest_process_range_backed(uint32_t address, uint64_t size) {
+    auto& p = current();
+    if (!p.base || !size || size > space_size - address) return 0;
+    std::lock_guard lock(p.memory_mutex);
+    auto it = p.regions.upper_bound(address);
+    if (it == p.regions.begin()) return 0;
