+/* Bulk libc writes share the conditional-store shards and SPU lock-line lock.
+ * Invalidate touched granules even when the bytes written equal their old value. */
+static void ppu_bulk_store(uint32_t dst, uint32_t src, uint32_t size, int fill, bool copy, const void* host = nullptr)
+{
+    if (!size) return;
+    const uint64_t end = (uint64_t)dst + size;
+    if (end > 0x100000000ull || (copy && (uint64_t)src + size > 0x100000000ull)) {
