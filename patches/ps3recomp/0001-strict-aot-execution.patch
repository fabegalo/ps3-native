+}
+extern "C" int guest_process_register_function(uint32_t address, guest_ppu_function fn) {
+    if (!address || (address & 3) || !fn) return 0;
+    auto& p = current(); std::unique_lock lock(p.functions_mutex);
+    p.functions[address] = fn; ++p.generation; return 1;
+}
+extern "C" guest_ppu_function guest_process_lookup_function(uint32_t address) {
+    auto& p = current(); std::shared_lock lock(p.functions_mutex);
+    auto it = p.functions.find(address); return it == p.functions.end() ? nullptr : it->second;
+}
+extern "C" uint32_t guest_process_function_count(void) {
+    auto& p = current(); std::shared_lock lock(p.functions_mutex); return uint32_t(p.functions.size());
+}
+extern "C" uint64_t guest_process_function_generation(void) { return current().generation.load(); }
+extern "C" uint32_t guest_process_resolve_host(void* address) {
+    auto& p = current(); std::unique_lock lock(p.functions_mutex);
+    if (p.inverse_generation != p.generation.load()) {
+        p.inverse.clear();
+        for (const auto& [guest, fn] : p.functions) p.inverse.emplace_back(reinterpret_cast<uintptr_t>(fn), guest);
+        std::sort(p.inverse.begin(), p.inverse.end()); p.inverse_generation = p.generation.load();
+    }
+    auto it = std::upper_bound(p.inverse.begin(), p.inverse.end(),
+        std::make_pair(reinterpret_cast<uintptr_t>(address), UINT32_MAX));
+    return it == p.inverse.begin() ? 0 : std::prev(it)->second;
+}
