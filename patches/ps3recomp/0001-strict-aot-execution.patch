+extern "C" int guest_process_unmap(uint32_t address, uint64_t size) {
+    auto& p = current();
+    if (!p.base || !valid_range(address, size)) return 0;
+    std::lock_guard lock(p.memory_mutex);
+    auto it = p.regions.find(address);
+    if (it == p.regions.end() || it->second.size != size || !it->second.mapped) return 0;
