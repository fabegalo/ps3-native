+extern "C" int guest_shared_close(guest_shared_id id) {
+    std::lock_guard lock(objects_mutex); return int(backings.erase(id));
+}
+extern "C" int guest_process_map_shared(guest_shared_id id, uint32_t address, uint64_t offset, uint64_t size) {
+    auto& p = current();
+    if (!p.base || !valid_range(address, size) || offset % page_size()) return 0;
+    std::shared_ptr<Backing> backing;
+    { std::lock_guard lock(objects_mutex);
+      auto it = backings.find(id); if (it == backings.end()) return 0; backing = it->second; }
+    if (offset > backing->size || size > backing->size - offset) return 0;
+    std::lock_guard lock(p.memory_mutex);
+    if (!placeholder(p, address, size)) return 0;
+#ifdef _WIN32
+    if (!map3()(backing->handle, GetCurrentProcess(), p.base + address, offset, SIZE_T(size),
+        MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0)) return 0;
+#else
+    if (mmap(p.base + address, size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED,
+        backing->handle, off_t(offset)) == MAP_FAILED) return 0;
+#endif
