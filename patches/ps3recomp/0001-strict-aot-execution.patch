+    const uint64_t last = (end - 1) & ~127ull;
+    if (last - first >= PPU_RESV_LOCKS * 16u) {
+        for (unsigned i = 0; i < PPU_RESV_LOCKS; ++i) shards[i] = true;
+    }
+    else for (uint64_t line = first; line <= last; line += 128)
+        for (unsigned word = 0; word < 128; word += 16)
+            shards[((line + word) >> 4) & (PPU_RESV_LOCKS - 1)] = true;
+    for (unsigned i = 0; i < PPU_RESV_LOCKS; ++i) if (shards[i]) resv_lock(g_resv_locks + i);
+    spu_lockline_lock();
+    if (host) memcpy(ppu_current_vm_base() + dst, host, size);
+    else if (copy) memcpy(ppu_current_vm_base() + dst, ppu_current_vm_base() + src, size);
