+/* ps3recomp - process-owned VM and AOT registrations; no second executor. */
+#include "guest_process.h"
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <shared_mutex>
+#include <vector>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#include <unistd.h>
+#include <fcntl.h>
+#endif
+
+namespace {
+constexpr uint64_t space_size = UINT64_C(0x100000000);
+struct Backing {
+#ifdef _WIN32
+    HANDLE handle = nullptr;
+    ~Backing() { if (handle) CloseHandle(handle); }
+#else
+    int handle = -1;
+    ~Backing() { if (handle >= 0) close(handle); }
+#endif
+    uint64_t size = 0;
+};
+struct Region {
+    uint64_t size;
+    bool mapped = false;
+    std::shared_ptr<Backing> shared;
+};
+struct Process {
+    guest_process_id id = 0;
+    uint8_t* base = nullptr;
+    std::atomic<unsigned> bindings{0};
+    std::mutex memory_mutex;
+    std::map<uint64_t, Region> regions;
+    std::shared_mutex functions_mutex;
+    std::map<uint32_t, guest_ppu_function> functions;
+    std::atomic<uint64_t> generation{0};
+    uint64_t inverse_generation = UINT64_MAX;
+    std::vector<std::pair<uintptr_t, uint32_t>> inverse;
+    std::mutex state_mutex;
+    std::shared_ptr<void> states[GUEST_PROCESS_STATE_COUNT];
+    ~Process() {
+        if (!base) return;
+#ifdef _WIN32
+        for (const auto& [start, r] : regions) {
+            if (r.shared) UnmapViewOfFile(base + start);
+            else VirtualFree(base + start, 0, MEM_RELEASE);
+        }
+#else
+        munmap(base, space_size);
+#endif
+    }
+};
+std::mutex objects_mutex;
+std::map<guest_process_id, std::shared_ptr<Process>> processes;
+std::map<guest_shared_id, std::shared_ptr<Backing>> backings;
+uint64_t next_process = 1, next_shared = 1;
+Process root;
+struct Binding {
+    std::shared_ptr<Process> process;
+    unsigned execution_depth = 0;
+    ~Binding() { if (process) --process->bindings; }
+};
+thread_local Binding binding;
+Process& current() { return binding.process ? *binding.process : root; }
+uint64_t page_size() {
+#ifdef _WIN32
+    SYSTEM_INFO info; GetSystemInfo(&info); return info.dwPageSize;
+#else
+    const long size = sysconf(_SC_PAGESIZE); return size > 0 ? uint64_t(size) : 0;
+#endif
+}
+bool valid_range(uint64_t address, uint64_t size) {
+    const uint64_t page = page_size();
+    return page && size && address < space_size && size <= space_size - address &&
+        address % page == 0 && size % page == 0;
+}
+#ifdef _WIN32
+using Alloc2 = PVOID (WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, void*, ULONG);
+using Map3 = PVOID (WINAPI*)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG, void*, ULONG);
+using Unmap2 = BOOL (WINAPI*)(HANDLE, PVOID, ULONG);
+Alloc2 alloc2() {
+    static auto fn = reinterpret_cast<Alloc2>(GetProcAddress(GetModuleHandleW(L"KernelBase.dll"), "VirtualAlloc2"));
+    return fn;
+}
+Map3 map3() {
+    static auto fn = reinterpret_cast<Map3>(GetProcAddress(GetModuleHandleW(L"KernelBase.dll"), "MapViewOfFile3"));
+    return fn;
+}
+Unmap2 unmap2() {
+    static auto fn = reinterpret_cast<Unmap2>(GetProcAddress(GetModuleHandleW(L"KernelBase.dll"), "UnmapViewOfFile2"));
+    return fn;
+}
+#endif
+/* Splits only reserved placeholders; mapped/private ranges are never replaced. */
+bool split(Process& p, uint64_t address) {
+    if (!address || address == space_size) return true;
+    auto it = p.regions.upper_bound(address);
+    if (it == p.regions.begin()) return false;
+    --it;
+    if (it->first == address) return true;
+    const uint64_t first = it->first, end = first + it->second.size;
+    if (it->second.mapped || address >= end) return false;
+#ifdef _WIN32
+    if (!VirtualFree(p.base + first, SIZE_T(address - first), MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) return false;
+#endif
+    it->second.size = address - first;
+    p.regions.emplace(address, Region{end - address});
+    return true;
+}
+bool empty_range(Process& p, uint64_t address, uint64_t size) {
+    auto it = p.regions.upper_bound(address);
+    if (it == p.regions.begin()) return false;
+    --it;
+    for (; it != p.regions.end() && it->first < address + size; ++it)
+        if (it->second.mapped) return false;
+    return true;
+}
+bool placeholder(Process& p, uint64_t address, uint64_t size) {
+    if (!empty_range(p, address, size) || !split(p, address) || !split(p, address + size)) return false;
+    auto first = p.regions.find(address), end = p.regions.lower_bound(address + size);
+    if (std::next(first) != end) {
+#ifdef _WIN32
+        if (!VirtualFree(p.base + address, SIZE_T(size), MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS)) return false;
+#endif
+        p.regions.erase(std::next(first), end);
+        first->second.size = size;
+    }
+    return true;
+}
+}
+
+extern "C" guest_process_id guest_process_create(void) {
+    auto p = std::make_shared<Process>();
+#ifdef _WIN32
+    if (!alloc2() || !map3() || !unmap2()) return 0;
+    /* Trim an aligned placeholder without releasing the selected address. */
+    uint8_t* reserve = static_cast<uint8_t*>(alloc2()(nullptr, nullptr, space_size * 2,
+        MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, nullptr, 0));
+    if (!reserve) return 0;
+    const uintptr_t aligned = (uintptr_t(reserve) + space_size - 1) & ~(space_size - 1);
+    const uint64_t prefix = aligned - uintptr_t(reserve);
+    if (prefix && !VirtualFree(reserve, SIZE_T(prefix), MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
+        VirtualFree(reserve, 0, MEM_RELEASE); return 0;
+    }
+    if (prefix) VirtualFree(reserve, 0, MEM_RELEASE);
+    p->base = reinterpret_cast<uint8_t*>(aligned);
+    const uint64_t remainder = space_size * 2 - prefix;
+    if (remainder > space_size) {
