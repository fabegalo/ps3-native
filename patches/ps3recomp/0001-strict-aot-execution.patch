+}
+extern "C" int guest_process_bind(guest_process_id id) {
+    if (binding.execution_depth) return 0;
+    std::lock_guard lock(objects_mutex);
+    std::shared_ptr<Process> next;
+    if (id) {
+        auto it = processes.find(id);
+        if (it == processes.end()) return 0;
+        next = it->second; ++next->bindings;
