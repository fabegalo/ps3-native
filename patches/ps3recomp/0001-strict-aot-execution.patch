+extern "C" void* guest_process_runtime_state(guest_process_state_slot slot, void* (*create)(void), void (*destroy)(void*)) {
+    if (slot < 0 || slot >= GUEST_PROCESS_STATE_COUNT || !create || !destroy) return nullptr;
